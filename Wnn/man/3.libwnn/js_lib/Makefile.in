include @top_srcdir@/makerule.mk
top_builddir = ../../../..

INSTALL         = @INSTALL@ $(INSTALLFLAGS)

MANDIR = $(LIBMANDIR)
MANSUFFIX = $(LIBMANSUFFIX)
MANUAL = access.man close.man connect.man dic_add.man dic_file_create.man dic_file_create_client.man dic_delete.man dic_info.man dic_list.man dic_list_all.man dic_use.man disconnect.man env_exist.man env_list.man env_sticky.man file_comment_set.man file_discard.man file_info.man file_list.man file_list_all.man file_loaded.man file_loaded_local.man file_password_set.man file_read.man file_receive.man file_remove.man file_remove_client.man file_send.man file_stat.man file_write.man fuzokugo_get.man fuzokugo_set.man hindo_file_create.man hindo_file_create_client.man hindo_set.man hinsi_dicts.man hinsi_list.man hinsi_name.man hinsi_number.man hinsi_table_set.man isconnect.man kanren.man kantan_dai.man kantan_sho.man kanzen_dai.man kanzen_sho.man kill.man mkdir.man open.man open_lang.man param_get.man set_lang.man version.man who.man word_add.man word_comment_set.man word_delete.man word_info.man word_search.man

all::

depend::

install.man:: $(MANUAL)
	@if [ -d $(DESTDIR)$(MANDIR) ]; then set +x; \
	else (set -x; $(MKDIRHIER) $(DESTDIR)$(MANDIR)); fi
	for m in $(MANUAL); do \
	$(RM) $(DESTDIR)$(MANDIR)/js_$${m%.man}.$(MANSUFFIX)*; \
	$(MANFILTER) < $$m > /tmp/$$m; \
	$(INSTALL) $(INSTMANFLAGS) /tmp/$$m $(DESTDIR)$(MANDIR)/js_$${m%.man}.$(MANSUFFIX); \
	$(RM) /tmp/$$m; \
	$(COMPRESSMANCMD) $(DESTDIR)$(MANDIR)/js_$${m%.man}.$(MANSUFFIX); \
	done

install.man::
	@(SUFFIX=`echo $(DESTDIR)$(MANDIR)/js_env_sticky.* | sed -e 's,.*/[^\.]*.,,'`; \
	for i in js_env_un_sticky; do (set -x; \
	$(RM) $(DESTDIR)$(MANDIR)/$$i.*; \
	(cd $(DESTDIR)$(MANDIR); $(LN) js_env_sticky.$${SUFFIX} \
	$$i.$${SUFFIX})); \
	done)

install.man::
	@(SUFFIX=`echo $(DESTDIR)$(MANDIR)/js_param_get.* | sed -e 's,.*/[^\.]*.,,'`; \
	for i in js_param_set; do (set -x; \
	$(RM) $(DESTDIR)$(MANDIR)/$$i.*; \
	(cd $(DESTDIR)$(MANDIR); $(LN) js_param_get.$${SUFFIX} \
	$$i.$${SUFFIX})); \
	done)

install.man::
	@(SUFFIX=`echo $(DESTDIR)$(MANDIR)/js_set_lang.* | sed -e 's,.*/[^\.]*.,,'`; \
	for i in js_get_lang; do (set -x; \
	$(RM) $(DESTDIR)$(MANDIR)/$$i.*; \
	(cd $(DESTDIR)$(MANDIR); $(LN) js_set_lang.$${SUFFIX} \
	$$i.$${SUFFIX})); \
	done)

install.man::
	@(SUFFIX=`echo $(DESTDIR)$(MANDIR)/js_word_search.* | sed -e 's,.*/[^\.]*.,,'`; \
	for i in js_word_search_by_env; do (set -x; \
	$(RM) $(DESTDIR)$(MANDIR)/$$i.*; \
	(cd $(DESTDIR)$(MANDIR); $(LN) js_word_search.$${SUFFIX} \
	$$i.$${SUFFIX})); \
	done)
