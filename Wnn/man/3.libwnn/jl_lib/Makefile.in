include @top_srcdir@/makerule.mk
top_builddir = ../../../..

INSTALL         = @INSTALL@ $(INSTALLFLAGS)

MANDIR = $(LIBMANDIR)
MANSUFFIX = $(LIBMANSUFFIX)
MANUAL = bun_suu.man c_zenkouho.man close.man connect.man connect_lang.man dai_top.man dic_add.man dic_comment_set.man dic_delete.man dic_list.man dic_save.man dic_use.man disconnect.man env.man env_get.man env_sticky.man fuzokugo_get.man fuzokugo_set.man get_kanji.man get_zenkouho_kanji.man hinsi_dicts.man hinsi_list.man hinsi_name.man hinsi_number.man inspect.man isconnect.man jiri_len.man kanji_len.man kill.man next.man nobi_conv.man open.man open_lang.man param_get.man ren_conv.man set_env_wnnrc.man set_jikouho.man tan_conv.man update_hindo.man word_add.man word_comment_set.man word_delete.man word_info.man word_search.man word_use.man zenkouho.man zenkouho_bun.man zenkouho_dai.man zenkouho_daip.man zenkouho_suu.man

install.man:: $(MANUAL)
	@if [ -d $(DESTDIR)$(MANDIR) ]; then set +x; \
	else (set -x; $(MKDIRHIER) $(DESTDIR)$(MANDIR)); fi
	for m in $(MANUAL); do \
	$(RM) $(DESTDIR)$(MANDIR)/$${m%.man}.$(MANSUFFIX)*; \
	$(MANFILTER) < $$m > /tmp/$$m; \
	$(INSTALL) $(INSTMANFLAGS) /tmp/$$m $(DESTDIR)$(MANDIR)/jl_$${m%.man}.$(MANSUFFIX); \
	$(COMPRESSMANCMD) $(DESTDIR)$(MANDIR)/jl_$${m%.man}.$(MANSUFFIX); \
	$(RM) /tmp/$$m; \
	done

install.man::
	@(SUFFIX=`echo $(DESTDIR)$(MANDIR)/jl_dic_add.* | sed -e 's,.*/[^\.]*.,,'`; \
	for i in jl_dic_add_e; do (set -x; \
	$(RM) $(DESTDIR)$(MANDIR)/$$i.*; \
	(cd $(DESTDIR)$(MANDIR); $(LN) jl_dic_add.$${SUFFIX} \
	$$i.$${SUFFIX})); \
	done)

